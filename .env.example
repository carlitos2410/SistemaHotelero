# Copia estos nombres a un archivo .env local. No guardes secretos reales en el proyecto.

# Entorno local: development | Entorno publicado: production
DJANGO_ENV=development
DEBUG=1

# Obligatorios en producción. Genera una clave larga y aleatoria.
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,[::1],testserver
CSRF_TRUSTED_ORIGINS=

# PostgreSQL
DB_NAME=sistema_hotelero_db
DB_USER=postgres
DB_PASSWORD=postgres

# pgAdmin local
PGADMIN_EMAIL=admin@admin.com
PGADMIN_PASSWORD=admin

# HTTPS se activa automáticamente cuando DJANGO_ENV=production. No declares
# valores en 0 para producción. Habilita el encabezado reenviado únicamente
# cuando exista un proxy confiable configurado correctamente:
# USE_X_FORWARDED_PROTO=1
#
# HSTS preload debe habilitarse manualmente solo después de confirmar que el
# dominio y todos sus subdominios funcionarán permanentemente por HTTPS:
# SECURE_HSTS_PRELOAD=1
